# Copy this file to `.env` (same folder) and fill in your values.
# `.env` is gitignored — never commit your real key.

# Your GIPHY API key from https://developers.giphy.com/dashboard/
# Leave empty to run without GIF search (uploads still work).
GIPHY_API_KEY=

# Port the relay listens on (HTTP + WebSocket share it).
PORT=8787

# Optional tuning (defaults shown):
# HOST=0.0.0.0
# MAX_IMAGE_MB=5            # biggest image a friend can upload
# MAX_ROOM_SIZE=30          # max people in one room
# GIPHY_RATING=pg-13        # g, pg, pg-13 or r
# GIPHY_LANG=en
# GIPHY_CACHE_SECONDS=300   # how long search results are cached
