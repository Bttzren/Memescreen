{
  "name": "memedrop",
  "productName": "MemeDrop",
  "version": "1.1.0",
  "description": "Send memes and GIFs onto your friends' screens.",
  "main": "src/main/main.js",
  "author": "MemeDrop",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bttzren/Memescreen.git"
  },
  "private": true,
  "scripts": {
    "sync-relay": "node scripts/sync-relay.js",
    "prestart": "node scripts/sync-relay.js",
    "start": "electron .",
    "pretest": "node scripts/sync-relay.js",
    "test": "node --test test/*.test.js",
    "pretest:e2e": "node scripts/sync-relay.js",
    "test:e2e": "node test/e2e/smoke.js",
    "predist": "node scripts/sync-relay.js",
    "dist": "electron-builder --config electron-builder.config.js --win --publish never",
    "predist:dir": "node scripts/sync-relay.js",
    "dist:dir": "electron-builder --config electron-builder.config.js --win --dir --publish never"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.0.12",
    "playwright-core": "^1.65.0"
  }
}
